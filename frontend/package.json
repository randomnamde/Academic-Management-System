{
  "name": "student-management-frontend",
  "version": "1.0.0",
  "description": "Student Management System Frontend",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue",
    "check:utf8": "node scripts/check-utf8.js",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@headlessui/vue": "^1.7.23",
    "axios": "^1.5.0",
    "dayjs": "^1.11.9",
    "echarts": "^5.4.3",
    "element-plus": "^2.3.14",
    "js-cookie": "^3.0.5",
    "lucide-vue-next": "^0.576.0",
    "nprogress": "^0.2.0",
    "vue": "^3.3.4",
    "vue-echarts": "^6.6.1",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.2.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.49",
    "sass": "^1.66.1",
    "tailwindcss": "^3.4.17",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vitest": "^1.6.0"
  },
  "overrides": {
