# Application identity
APP_NAME=student-management
APP_HOME=/opt/student-management
APP_JAR=/opt/student-management/backend/student-management.jar
JAVA_BIN=/usr/bin/java

# Runtime profile
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=student_management
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# Security and cross-origin
JWT_SECRET=replace_with_a_long_random_secret
CORS_ALLOWED_ORIGINS=http://your-server-ip,http://your-domain

# Files and logs
FILE_UPLOAD_DIR=/opt/student-management/uploads
APP_LOG_FILE=/opt/student-management/logs/student-management.log
PID_FILE=/opt/student-management/run/student-management.pid
CONSOLE_LOG_FILE=/opt/student-management/logs/console.out

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
